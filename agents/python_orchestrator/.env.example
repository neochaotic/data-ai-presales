# Configuração para o Vertex AI / Agent Development Kit (ADK)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=gemini-demo-qi
GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL_NAME=gemini-2.5-flash

# App Gemini Enterprise criado no projeto gemini-demo-qi
GEMINI_ENTERPRISE_ENGINE_ID=alisson-demo_1792679266221
GEMINI_ENTERPRISE_LOCATION=global

# Endpoint do Agente Microsserviço em Go (ADK Go v2)
GO_AGENT_ENDPOINT=http://localhost:8081/api/v1/evaluate

# Cenário de Demonstração (VAREJO_OMNICANAL por padrão)
DEMO_SCENARIO=VAREJO_OMNICANAL
